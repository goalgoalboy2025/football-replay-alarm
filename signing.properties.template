# 把这个文件复制成 signing.properties（同目录），填上你自己的值。
# signing.properties 已在 .gitignore 里——绝对不要提交到 git。
#
# 怎么生成 keystore：
#   keytool -genkey -v -keystore kanqiutixing-release.jks \
#           -keyalg RSA -keysize 2048 -validity 25000 \
#           -alias kanqiutixing
# 把生成的 .jks 文件放到项目根目录（同样在 .gitignore 里，不会被提交）。
#
# storeFile  填生成的 keystore 文件相对路径
# storePassword / keyPassword 是 keytool 创建时输入的密码
# keyAlias 是 -alias 参数的值

storeFile=kanqiutixing-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=kanqiutixing
keyPassword=YOUR_KEY_PASSWORD
